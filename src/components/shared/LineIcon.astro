---
import type { IconData } from '../../lib/line-icon';
import { renderIconSvg } from '../../lib/line-icon';

interface Props {
  icon: IconData;
  size?: number;
  class?: string;
}

const { icon, size = 24, class: className } = Astro.props;
const svg = renderIconSvg(icon);
---

<svg
  width={size}
  height={size}
  viewBox={icon.viewBox}
  fill={icon.defaultFill || 'none'}
  stroke={icon.defaultStroke || 'none'}
  class={className}
  aria-hidden="true"
  set:html={svg}
/>
