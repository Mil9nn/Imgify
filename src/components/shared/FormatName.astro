---
import { FORMAT_ICONS } from '../../lib/format-icons';

interface Props {
  format: string;
  size?: 'default' | 'sm';
}

const { format, size = 'default' } = Astro.props;

const icon = FORMAT_ICONS[format];
const isSm = size === 'sm';
---

{
  icon ? (
    <span class="inline-flex items-center gap-1">
      <img
        src={icon}
        alt=""
        aria-hidden="true"
        width={isSm ? 18 : 30}
        height={isSm ? 22 : 36}
        class:list={['w-auto shrink-0', isSm ? 'h-[1em]' : 'h-[1.7em]']}
      />
      <span class="text-ink">{format}</span>
    </span>
  ) : (
    <span class="text-ink">{format}</span>
  )
}
