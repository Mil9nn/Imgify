---
import { formatBadgeClass } from '../../lib/format-icons';

interface Props {
  format: string;
  size?: 'sm' | 'default' | 'lg' | 'hero';
  emphasis?: 'source' | 'destination';
}

const { format, size = 'default', emphasis } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center font-mono uppercase tracking-wide',
    formatBadgeClass(format),
    size === 'sm' && 'text-caption font-medium',
    size === 'default' && 'text-body-sm font-medium',
    size === 'lg' && 'text-body-sm font-semibold sm:text-body-md',
    size === 'hero' && 'text-[1em] font-semibold leading-[inherit]',
    emphasis === 'source' && size !== 'hero' && 'opacity-75',
  ]}
>
  {format}
</span>
