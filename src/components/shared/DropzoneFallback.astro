---
import LineIcon from './LineIcon.astro';
import { Upload1Duotone } from '@lineiconshq/free-icons';

interface Props {
  hint?: string;
  subhint?: string;
}

const {
  hint = 'Drag images here or click to upload',
  subhint = 'PNG, JPG, WEBP — bulk upload supported',
} = Astro.props;
---

<div class="compressor-workspace" aria-busy="true" aria-label="Loading image tool">
  <aside class="compressor-panel hidden lg:block" aria-hidden="true">
    <div class="h-40 animate-pulse rounded-md bg-canvas-soft-2"></div>
  </aside>
  <div class="compressor-main">
    <div class="compressor-dropzone">
      <span class="compressor-dropzone-icon">
        <LineIcon icon={Upload1Duotone} size={24} />
      </span>
      <p class="type-label mt-4">{hint}</p>
      <p class="type-body-sm mt-1">{subhint}</p>
    </div>
  </div>
</div>
