---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LineIcon from './LineIcon.astro';
import { ArrowRightDuotone } from '@lineiconshq/free-icons';

interface NavLink {
  href: string;
  title: string;
  desc: string;
}

interface Props {
  title: string;
  description: string;
  code: string;
  eyebrow: string;
  headline: string;
  message: string;
  navLinks: NavLink[];
}

const { title, description, code, eyebrow, headline, message, navLinks } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="bg-canvas-soft">
    <section class="error-hero relative overflow-hidden">
      <div class="error-mesh" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-3xl px-4 py-20 text-center md:py-28">
        <p class="type-mono-eyebrow mb-6">{eyebrow}</p>
        <p class="error-code mb-4 font-mono">{code}</p>
        <h1 class="error-headline mb-4">{headline}</h1>
        <p class="type-lead mx-auto max-w-xl text-body">{message}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <slot name="actions" />
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-3xl px-4 pb-20">
      <p class="type-mono-eyebrow mb-4 text-center">Navigate</p>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          navLinks.map((link) => (
            <a href={link.href} class="error-nav-link group">
              <LineIcon
                icon={ArrowRightDuotone}
                size={18}
                class="mt-0.5 shrink-0 text-mute transition-all group-hover:translate-x-0.5 group-hover:text-link"
              />
              <div class="min-w-0 text-left">
                <h2 class="type-subheading mb-0.5">{link.title}</h2>
                <p class="type-body-sm">{link.desc}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
