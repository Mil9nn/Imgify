---
import type { IconData } from '../../lib/line-icon';
import FormatName from './FormatName.astro';
import LineIcon from './LineIcon.astro';
import { ArrowRightDuotone } from '@lineiconshq/free-icons';

interface Props {
  href: string;
  description: string;
  accentColor: 'blue' | 'violet' | 'emerald';
  fromFormat?: string;
  toFormat?: string;
  title?: string;
  icon?: IconData;
}

const { href, description, accentColor, fromFormat, toFormat, title, icon } = Astro.props;

const isConversion = fromFormat && toFormat;

const iconBgClasses = {
  blue: 'bg-blue-100 text-blue-600 group-hover:bg-blue-600 group-hover:text-white dark:bg-blue-950/50 dark:text-blue-400 dark:group-hover:bg-blue-600 dark:group-hover:text-white',
  violet: 'bg-violet-100 text-violet-600 group-hover:bg-violet-600 group-hover:text-white dark:bg-violet-950/50 dark:text-violet-400 dark:group-hover:bg-violet-600 dark:group-hover:text-white',
  emerald: 'bg-emerald-100 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white dark:bg-emerald-950/50 dark:text-emerald-400 dark:group-hover:bg-emerald-600 dark:group-hover:text-white',
};

const hoverClasses = {
  blue: 'hover:border-blue-200 hover:shadow-blue-100/80 dark:hover:border-blue-800 dark:hover:shadow-blue-950/50',
  violet: 'hover:border-violet-200 hover:shadow-violet-100/80 dark:hover:border-violet-800 dark:hover:shadow-violet-950/50',
  emerald: 'hover:border-emerald-200 hover:shadow-emerald-100/80 dark:hover:border-emerald-800 dark:hover:shadow-emerald-950/50',
};
---

<a
  href={href}
  class:list={[
    'group block rounded-2xl border border-hairline bg-canvas p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg',
    hoverClasses[accentColor],
  ]}
>
  <div class="mb-3 flex items-start justify-between gap-3">
    {
      isConversion ? (
        <h2 class="type-label">
          <span class="inline-flex flex-wrap items-center gap-1">
            <FormatName format={fromFormat} size="sm" />
            <span class="font-normal text-mute">to</span>
            <FormatName format={toFormat} size="sm" />
          </span>
        </h2>
      ) : (
        <span
          class:list={[
            'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl transition-colors duration-200',
            iconBgClasses[accentColor],
          ]}
        >
          {icon && <LineIcon icon={icon} size={24} />}
        </span>
      )
    }
    <LineIcon
      icon={ArrowRightDuotone}
      size={16}
      class="mt-0.5 shrink-0 text-mute transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-body"
    />
  </div>
  {!isConversion && title && <h2 class="type-card-title mb-2">{title}</h2>}
  <p class="type-body-sm">{description}</p>
</a>
