---
import type { IconData } from '../../lib/line-icon';
import LineIcon from './LineIcon.astro';
import { ArrowRightDuotone } from '@lineiconshq/free-icons';

interface Props {
  href: string;
  title: string;
  description: string;
  accentColor: 'blue' | 'violet' | 'emerald';
  badge?: string;
  icon: IconData;
}

const { href, title, description, accentColor, badge, icon } = Astro.props;

const accentClasses = {
  blue: 'border-blue-200 bg-blue-50 text-blue-700',
  violet: 'border-violet-200 bg-violet-50 text-violet-700',
  emerald: 'border-emerald-200 bg-emerald-50 text-emerald-700',
};

const iconBgClasses = {
  blue: 'bg-blue-100 text-blue-600 group-hover:bg-blue-600 group-hover:text-white',
  violet: 'bg-violet-100 text-violet-600 group-hover:bg-violet-600 group-hover:text-white',
  emerald: 'bg-emerald-100 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white',
};

const hoverClasses = {
  blue: 'hover:border-blue-200 hover:shadow-blue-100/80',
  violet: 'hover:border-violet-200 hover:shadow-violet-100/80',
  emerald: 'hover:border-emerald-200 hover:shadow-emerald-100/80',
};
---

<a
  href={href}
  class:list={[
    'group block rounded-2xl border border-gray-200/80 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg',
    hoverClasses[accentColor],
  ]}
>
  <div class="mb-4 flex items-start justify-between gap-3">
    <span
      class:list={[
        'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl transition-colors duration-200',
        iconBgClasses[accentColor],
      ]}
    >
      <LineIcon icon={icon} size={24} />
    </span>
    <span class="flex items-center gap-2">
      <span
        class:list={[
          'inline-flex rounded-full border px-2.5 py-0.5 text-xs font-medium',
          accentClasses[accentColor],
        ]}
      >
        {badge ?? 'Free Tool'}
      </span>
      <LineIcon
        icon={ArrowRightDuotone}
        size={18}
        class="text-gray-300 transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-gray-500"
      />
    </span>
  </div>
  <h2 class="mb-2 text-lg font-semibold text-gray-900">{title}</h2>
  <p class="text-sm leading-relaxed text-gray-600">{description}</p>
</a>
