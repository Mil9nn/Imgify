---
import type { IconData } from '../../lib/line-icon';
import FormatName from './FormatName.astro';
import LineIcon from './LineIcon.astro';
import { ArrowRightDuotone } from '@lineiconshq/free-icons';

interface Props {
  href: string;
  description: string;
  fromFormat?: string;
  toFormat?: string;
  title?: string;
  icon?: IconData;
}

const { href, description, fromFormat, toFormat, title, icon } = Astro.props;

const isConversion = fromFormat && toFormat;

const iconBgClasses =
  'bg-blue-100 text-blue-600 group-hover:bg-blue-600 group-hover:text-white dark:bg-blue-950/50 dark:text-blue-400 dark:group-hover:bg-blue-600 dark:group-hover:text-white';

const cardHoverClasses =
  'hover:border-blue-200 hover:shadow-blue-100/80 dark:hover:border-blue-800 dark:hover:shadow-blue-950/50';
---

<a
  href={href}
  class:list={[
    'group relative block overflow-hidden rounded-2xl border border-hairline bg-canvas p-5 shadow-[0_1px_2px_#0000000a] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_-8px_#0000001a] sm:p-6',
    cardHoverClasses,
  ]}
>
  <div class="mb-3 flex items-start justify-between gap-3">
    {
      isConversion ? (
        <h2 class="type-card-title min-w-0">
          <span class="inline-flex flex-wrap items-center gap-1.5 sm:gap-2">
            <FormatName format={fromFormat} size="lg" />
            <LineIcon icon={ArrowRightDuotone} size={16} class="shrink-0 text-mute" />
            <FormatName format={toFormat} size="lg" />
          </span>
        </h2>
      ) : (
        <span
          class:list={[
            'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl transition-colors duration-200',
            iconBgClasses,
          ]}
        >
          {icon && <LineIcon icon={icon} size={24} />}
        </span>
      )
    }
    <LineIcon
      icon={ArrowRightDuotone}
      size={16}
      class="mt-1 shrink-0 text-mute transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-body"
    />
  </div>
  {!isConversion && title && <h2 class="type-card-title mb-2">{title}</h2>}
  <p class="type-body-sm">{description}</p>
</a>
