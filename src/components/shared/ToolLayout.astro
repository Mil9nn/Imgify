---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BRAND_NAME } from '../../lib/brand';
import LineIcon from './LineIcon.astro';
import { ArrowRightDuotone, ChevronDownDuotone } from '@lineiconshq/free-icons';

interface Faq {
  q: string;
  a: string;
}

interface RelatedTool {
  href: string;
  title: string;
  desc: string;
}

interface Step {
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  tagline: string;
  intro: string;
  accentColor: 'blue' | 'violet' | 'emerald';
  toolName: string;
  faqs: Faq[];
  relatedTools: RelatedTool[];
  steps: Step[];
}

const {
  title,
  description,
  canonical,
  tagline,
  intro,
  accentColor,
  toolName,
  faqs,
  relatedTools,
  steps,
} = Astro.props;

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://imgify.com';
const toolUrl = `${site}${canonical}`;

const accentHeading = {
  blue: 'text-blue-600',
  violet: 'text-violet-600',
  emerald: 'text-emerald-600',
};

const accentBorder = {
  blue: 'border-blue-500',
  violet: 'border-violet-500',
  emerald: 'border-emerald-500',
};

const accentStep = {
  blue: 'bg-blue-600',
  violet: 'bg-violet-600',
  emerald: 'bg-emerald-600',
};

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${BRAND_NAME} ${toolName}`,
  url: toolUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[webAppJsonLd, faqJsonLd]}
>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <header class:list={['mb-8 border-l-4 pl-5', accentBorder[accentColor]]}>
      <p class:list={['type-eyebrow mb-2', accentHeading[accentColor]]}>Free online tool</p>
      <h1 class="type-tool-header-title mb-2">{toolName}</h1>
      <p class="type-tool-header-lead">{tagline}</p>
    </header>

    <slot />

    <div id="ad-slot-top" class="ad-container">Advertisement</div>

    <section class="my-12">
      <h2 class="type-section-title mb-6">How it works</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <div class="surface-muted p-5">
              <div
                class:list={[
                  'type-body-sm mb-3 flex h-8 w-8 items-center justify-center rounded-full font-semibold text-white',
                  accentStep[accentColor],
                ]}
              >
                {index + 1}
              </div>
              <h3 class="type-subheading mb-2">{step.title}</h3>
              <p class="type-body-sm">{step.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div id="ad-slot-mid" class="ad-container">Advertisement</div>

    <section class="my-12">
      <h2 class="type-section-title mb-4">About this tool</h2>
      <p class="type-body">{intro}</p>
    </section>

    <div id="ad-slot-bottom" class="ad-container">Advertisement</div>

    <section class="my-12">
      <h2 class="type-section-title mb-6">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {
          faqs.map((faq) => (
            <details class="group surface-card">
              <summary class="type-subheading cursor-pointer px-5 py-4 marker:content-none">
                <span class="flex items-center justify-between">
                  {faq.q}
                  <LineIcon
                    icon={ChevronDownDuotone}
                    size={20}
                    class="ml-4 shrink-0 text-mute transition-transform group-open:rotate-180"
                  />
                </span>
              </summary>
              <p class="type-body-sm border-t border-hairline px-5 py-4">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="my-12">
      <h2 class="type-section-title mb-6">Related Tools</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          relatedTools.map((tool) => (
            <a
              href={tool.href}
              class="group flex items-start gap-3 rounded-xl border border-hairline bg-canvas p-4 transition-all hover:border-hairline hover:bg-canvas-soft hover:shadow-sm"
            >
              <LineIcon
                icon={ArrowRightDuotone}
                size={18}
                class="mt-0.5 shrink-0 text-mute transition-all group-hover:translate-x-0.5 group-hover:text-link"
              />
              <div>
                <h3 class="type-subheading mb-1">{tool.title}</h3>
                <p class="type-body-sm">{tool.desc}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
