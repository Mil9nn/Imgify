---
import '../styles/global.css';
import ThemeToggle from '../components/shared/ThemeToggle.astro';
import { BRAND_NAME, BRAND_TAGLINE, BRAND_URL } from '../lib/brand';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  jsonLd,
} = Astro.props;

const site = Astro.site?.href.replace(/\/$/, '') ?? BRAND_URL;
const canonicalUrl = canonical ? `${site}${canonical}` : Astro.url.href;
const jsonLdScripts = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TKSFC1E48Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-TKSFC1E48Y');
    </script>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={BRAND_NAME} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
    {
      jsonLdScripts.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    <slot name="head" />
  </head>
  <body class="min-h-screen font-sans">
    <header class="sticky top-0 z-50 border-b border-hairline/80 bg-canvas/85 backdrop-blur-lg backdrop-saturate-150">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:py-3.5">
        <a href="/" class="group flex items-center gap-2.5">
          <img
            src="/logo2.png"
            alt=""
            aria-hidden="true"
            width="36"
            height="36"
            class="h-9 w-9 object-contain transition-transform group-hover:scale-105"
          />
          <span class="type-card-title text-brand-gradient">{BRAND_NAME}</span>
        </a>
        <ThemeToggle />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-8 border-t border-hairline/80 bg-canvas-soft sm:mt-10">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
        <div class="mb-6 flex flex-col items-center gap-3 sm:flex-row sm:justify-between">
          <a href="/" class="group flex items-center gap-2">
            <img
              src="/logo2.png"
              alt=""
              aria-hidden="true"
              width="32"
              height="32"
              class="h-8 w-8 object-contain transition-transform group-hover:scale-105"
            />
            <span class="type-subheading text-brand-gradient">{BRAND_NAME}</span>
          </a>
          <p class="type-body-sm">{BRAND_TAGLINE}</p>
        </div>
        <div class="type-body-sm flex flex-col items-center gap-3 text-mute">
          <nav class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
            <a href="/about" class="transition-colors hover:text-body">About</a>
            <a href="/contact" class="transition-colors hover:text-body">Contact</a>
            <a href="/privacy" class="transition-colors hover:text-body">Privacy</a>
            <a href="/terms" class="transition-colors hover:text-body">Terms</a>
          </nav>
          <p>&copy; {new Date().getFullYear()} {BRAND_NAME}. {BRAND_TAGLINE}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
