---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  heading: string;
}

const { title, description, canonical, heading } = Astro.props;
const lastUpdated = 'June 8, 2026';
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:py-14">
    <header class="mb-10 rounded-xl border border-hairline bg-canvas p-6 pb-8 sm:p-8">
      <h1 class="type-page-title mb-2">{heading}</h1>
      <p class="type-caption">Last updated: {lastUpdated}</p>
    </header>
    <div class="type-body space-y-8">
      <slot />
    </div>
  </article>
</BaseLayout>
