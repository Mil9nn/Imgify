---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  heading: string;
}

const { title, description, canonical, heading } = Astro.props;
const lastUpdated = 'June 8, 2026';
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-10 border-b border-gray-100 pb-8">
      <h1 class="mb-2 text-3xl font-bold tracking-tight text-gray-900">{heading}</h1>
      <p class="text-sm text-gray-500">Last updated: {lastUpdated}</p>
    </header>
    <div class="space-y-8 text-base leading-relaxed text-gray-600">
      <slot />
    </div>
  </article>
</BaseLayout>
