---
import ToolLayout from '../../components/shared/ToolLayout.astro';
import DropzoneFallback from '../../components/shared/DropzoneFallback.astro';
import ImageConverter from '../../components/tools/ImageConverter';
import {
  conversionPages,
  getConversionSteps,
  getRelatedConversions,
} from '../../lib/conversion-pages';
import { formatsFromConversionSlug } from '../../lib/format-icons';

export function getStaticPaths() {
  return conversionPages.map((page) => ({
    params: { conversion: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const formats = formatsFromConversionSlug(page.slug)!;

const steps = getConversionSteps(
  page.slug.split('-to-')[0].toUpperCase(),
  page.defaultFormat.toUpperCase(),
);

const relatedConversions = getRelatedConversions(page.slug, 2);

const relatedTools = [
  ...relatedConversions,
  {
    href: '/tools/img-to-pdf',
    title: 'Image to PDF Converter',
    desc: 'Combine images into a single multi-page PDF document.',
  },
];
---

<ToolLayout
  title={page.title}
  description={page.description}
  canonical={`/tools/${page.slug}`}
  tagline={page.tagline}
  intro={page.intro}
  fromFormat={formats.from}
  toFormat={formats.to}
  toolName={page.toolName}
  faqs={page.faqs}
  relatedTools={relatedTools}
  steps={steps}
>
  <ImageConverter
    client:only="react"
    defaultFormat={page.defaultFormat}
    uploadHint={page.uploadHint}
  >
    <DropzoneFallback
      slot="fallback"
      hint={page.uploadHint ?? 'Drag images here or click to upload'}
      subhint="or click to browse — bulk upload supported"
    />
  </ImageConverter>
</ToolLayout>
