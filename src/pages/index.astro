---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND_NAME, BRAND_TAGLINE } from '../lib/brand';
import ToolCard from '../components/shared/ToolCard.astro';
import LineIcon from '../components/shared/LineIcon.astro';
import { conversionPages } from '../lib/conversion-pages';
import { formatsFromConversionSlug } from '../lib/format-icons';
import { Bolt2Duotone, Gauge1Duotone } from '@lineiconshq/free-icons';

const tools = [
  {
    href: '/tools/heic-to-jpg',
    fromFormat: 'HEIC',
    toFormat: 'JPG',
    description:
      'Free HEIC to JPG converter — convert HEIC to JPG online on Windows, Mac & iPhone.',
  },
  ...conversionPages.map((page) => {
    const formats = formatsFromConversionSlug(page.slug)!;
    return {
      href: `/tools/${page.slug}`,
      fromFormat: formats.from,
      toFormat: formats.to,
      description: page.tagline,
    };
  }),
  {
    href: '/tools/img-to-pdf',
    fromFormat: 'IMG',
    toFormat: 'PDF',
    description:
      'Free image to PDF converter — convert image to PDF online, combine photos into one document.',
  },
  {
    href: '/tools/image-compressor',
    title: 'Image Compressor',
    description:
      'Free image compressor — lossy and lossless compression with quality control, runs in your browser.',
    icon: Gauge1Duotone,
  },
];

---

<BaseLayout
  title={`${BRAND_NAME} — Convert, Compress & Optimize Images Online`}
  description={`${BRAND_TAGLINE} Free HEIC to JPG, JPG to PNG, image compressor, PDF tools, and more — no signup required.`}
  canonical="/"
>
  <div class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-72 bg-gradient-to-b from-blue-50/80 via-violet-50/40 to-transparent dark:from-blue-950/40 dark:via-violet-950/25 dark:to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-4 pt-14 pb-6 sm:pt-16 sm:pb-8 md:pt-20">
      <section class="mb-14 text-center">
        <p
          class="type-badge mb-4 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-canvas/80 px-4 py-1.5 text-blue-700 shadow-sm backdrop-blur-sm dark:border-blue-900/50 dark:bg-canvas/60 dark:text-blue-300"
        >
          <LineIcon icon={Bolt2Duotone} size={16} class="text-blue-600" />
          Free tools · No signup · Instant download
        </p>
        <h1 class="type-hero text-ink">
          Convert, compress and optimize images in your browser.
        </h1>
      </section>

      <section>
        <h2 class="type-section-title mb-6">All Tools</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {tools.map((tool) => <ToolCard {...tool} />)}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
